{
  "name": "flow5-final-presentation-components",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "overrides": {
    "floating-vue": "5.2.2"
  },
  "dependencies": {
    "@slidev/cli": "52.19.1",
    "@slidev/theme-default": "0.25.0",
    "three": "^0.180.0",
    "pptxgenjs": "4.0.1",
    "playwright-chromium": "1.63.0"
  },
  "scripts": {
    "dev": "slidev --port 18341",
    "build": "slidev build",
    "preview": "vite preview --host 127.0.0.1 --strictPort",
    "qa": "node qa-show.mjs",
    "test:slides": "node qa-show.mjs",
    "test:density": "node scripts/verify-density.mjs",
    "prebuild": "node scripts/sync-evidence.mjs && node scripts/validate-evidence.mjs",
    "test:data": "node scripts/validate-evidence.mjs",
    "figures": "python3 scripts/make-figures.py",
    "export": "slidev export --format pdf",
    "export:png": "slidev export --format png"
  }
}
